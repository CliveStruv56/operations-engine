# Copy to infra/.env (gitignored). Compose resolves ${VARS} from this file
# because the project directory for `-f infra/docker-compose.dev.yml` is infra/.

# Admin key for the LiteLLM proxy — generate with: openssl rand -hex 32
# Must match LITELLM_MASTER_KEY in apps/api/.env.
LITELLM_MASTER_KEY=sk-dev-master-key

# Fernet key the worker uses to decrypt tenant virtual keys — must match
# LITELLM_KEY_ENCRYPTION_KEY in apps/api/.env. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LITELLM_KEY_ENCRYPTION_KEY=

# Provider keys (used by the LiteLLM container only; the API never sees them)
DEEPINFRA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Object storage credentials shared by MinIO and the worker (defaults are the
# dev MinIO root user). Point the API's apps/api/.env STORAGE_* at the same
# values, endpoint http://127.0.0.1:9000.
STORAGE_BUCKET=vault
STORAGE_ACCESS_KEY=minio-dev
STORAGE_SECRET_KEY=minio-dev-secret
