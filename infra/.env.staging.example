# Staging environment matrix — docs/staging-deploy-checklist.md §3.
# Copy to infra/.env.staging (gitignored, chmod 600), fill in, then paste into
# Coolify's env editor (or pass --env-file on a plain Docker host).
# Generation session note: `bash infra/…` snippets for each secret are in the
# comments below.

# --- Database roles (checklist §2) ---
# openssl rand -base64 24 | tr -d '/+=' — one each, also used in staging-roles.sql
OPS_DB_PASSWORD=
OPS_APP_DB_PASSWORD=
LITELLM_DB_PASSWORD=

# --- LiteLLM proxy ---
# openssl rand -hex 32 (prefix sk- to taste)
LITELLM_MASTER_KEY=
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# MUST be identical on API and worker; API refuses boot without it.
LITELLM_KEY_ENCRYPTION_KEY=
# Provider keys (LiteLLM container only; the API never sees them)
DEEPINFRA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Auth (real Supabase project; leave SUPABASE_JWT_SECRET unset) ---
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- API ---
# Validator rejects "*" — the exact staging web origin.
CORS_ORIGINS=https://<staging-web-domain>
# Operator console: comma-separated login emails allowed on /admin.
PLATFORM_ADMIN_EMAILS=
# false = invite-only: only platform admins can create workspaces; clients
# arrive via owner invites from the /admin console.
OPEN_SIGNUP=false

# --- Object storage: Cloudflare R2 (creds from infra/.env.r2-staging) ---
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_BUCKET=ai-engine-files
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# --- Observability ---
SENTRY_DSN_API=
SENTRY_DSN_WORKER=

# --- Web build args (NEXT_PUBLIC_* bake into the bundle at build) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=https://<staging-api-domain>
# Presigned-URL open allowlist — the R2 endpoint origin.
NEXT_PUBLIC_STORAGE_ORIGIN=https://<account_id>.r2.cloudflarestorage.com
