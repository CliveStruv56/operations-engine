# Owner/migration connection (Alembic runs as this user)
DATABASE_URL=postgresql://ops:ops@localhost:5432/ops_engine
# Runtime connection — non-owner role, RLS enforced. Created by migration 0001
# in dev/CI; in production create it manually with a strong password.
APP_DATABASE_URL=postgresql://ops_app:ops_app@localhost:5432/ops_engine

# Supabase auth — set ONE of these. Local dev/tests use the HS256 secret;
# production uses the project's JWKS URL.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=dev-secret-change-me-loremipsum32chars

REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=
ENVIRONMENT=dev

# LiteLLM proxy (infra/docker-compose.dev.yml). Leave base URL empty to run
# without a model gateway (chat returns 503; unit tests do this).
# Master key must match infra/.env.
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-dev-master-key
