      { "stage_key": "monitor", "title": "Notify the funder of any material change to the project" },
      { "stage_key": "evaluate", "title": "Aggregate outcomes across all reporting periods", "tags": ["impact"] },
      { "stage_key": "evaluate", "title": "Complete the end-of-grant evaluation", "is_milestone": true },
      { "stage_key": "evaluate", "title": "Confirm any unspent funds position with the funder", "tags": ["finance"] },
      { "stage_key": "evaluate", "title": "Write up what to repeat and what to change next time" }
