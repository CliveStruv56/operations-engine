      { "doc_type_key": "project_budget", "title": "Project budget", "stage_key": "apply", "ai_draftable": false },
      { "doc_type_key": "annual_accounts", "title": "Most recent annual accounts", "stage_key": "apply", "ai_draftable": false },
      { "doc_type_key": "safeguarding_policy", "title": "Safeguarding policy", "stage_key": "apply", "ai_draftable": false },
      { "doc_type_key": "equality_policy", "title": "Equality and diversity policy", "stage_key": "apply", "ai_draftable": false },
      { "doc_type_key": "award_letter", "title": "Award letter and offer conditions", "stage_key": "decision", "ai_draftable": false },
