# From `supabase start` locally, or the Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: origin of presigned storage URLs (MinIO/R2). When set, the app
# refuses to open download links pointing anywhere else.
NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9000
